PORT=5000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name

TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone

SHIPROCKET_EMAIL=your_email
SHIPROCKET_PASSWORD=your_password

EMAIL_USER=your_email
EMAIL_PASS=your_email_app_password

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

CLIENT_URL=http://localhost:5173

# Security & Session Configurations
# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens (JWT) for admin password resets
JWT_SECRET=your_jwt_secret_key_here
# MASTER_SECURITY_KEY: Confidential master key used for core database encryption/integrity
MASTER_SECURITY_KEY=your_master_security_key_here
# NODE_ENV: Operating environment context. Options: development, production, test
NODE_ENV=development

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
